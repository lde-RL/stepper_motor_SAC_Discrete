# Relay configuration. Copy to relay/.env and fill in.
# All secrets live here, on the relay only — never in the G2 WebView app.

# Port the relay listens on (Tailscale Serve forwards HTTPS to this).
PORT=8787

# Shared token the G2 app must present as ?token=... on the WS upgrade.
# Generate something long and random, e.g. `openssl rand -hex 32`.
SHARED_TOKEN=change-me

# Deepgram streaming STT.
DEEPGRAM_API_KEY=
STT_LANGUAGE=ko
STT_MODEL=nova-3

# Anthropic (Claude) — read implicitly by the SDK.
ANTHROPIC_API_KEY=

# Notion integration token + target database.
# The integration must be shared with the database.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Session boundary / filtering.
SILENCE_TIMEOUT_MS=90000
MIN_WORDS=30

# Where raw transcripts are written if Notion save fails.
FAILSAFE_DIR=./failsafe
